FILEMIND_OWNER_URL=https://owner.filemind.example
FILEMIND_PUBLIC_URL=https://files.filemind.example
FILEMIND_ADMIN_URL=https://admin.filemind.example
# true restricts administrator sign-in to FILEMIND_ADMIN_URL. Recreate the container after changing.
FILEMIND_REQUIRE_PRIVATE_ADMIN_SIGN_IN=false
FILEMIND_OWNER_USERNAME=admin
FILEMIND_DEFAULT_EXPIRY=24h
FILEMIND_DEFAULT_DOWNLOAD_LIMIT=0
FILEMIND_MAX_FILE_SIZE=2147483648
FILEMIND_MAX_TRANSFER_SIZE=2147483648
FILEMIND_STORAGE_QUOTA=21474836480
FILEMIND_MIN_FREE_SPACE=1073741824
